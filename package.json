{
  "name": "pet_blog",
  "version": "0.1.0",
  "private": true,
  "description": "반려동물 용품 리뷰와 비용 분석",
  "scripts": {
    "content:sync": "node scripts/sync-content.mjs",
    "dev": "npm run content:sync && next dev",
    "build": "npm run content:sync && next build && node scripts/prune-static-output.mjs && node scripts/verify-static-output.mjs",
    "start": "next start",
    "lint": "eslint",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "next": "^16.4.0",
    "openai": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
